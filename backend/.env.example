# ai_multi_agent Environment Variables

# === Project ===
PROJECT_NAME=ai_multi_agent
DEBUG=true
ENVIRONMENT=local
TIMEZONE=UTC  # IANA timezone: UTC, Europe/Warsaw, America/New_York
MODELS_CACHE_DIR=./models_cache

# === Logfire ===
# Get your token at https://logfire.pydantic.dev
LOGFIRE_TOKEN=
LOGFIRE_SERVICE_NAME=ai_multi_agent
LOGFIRE_ENVIRONMENT=development

# === PostgreSQL ===
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ai_multi_agent

# === JWT Auth ===
# Generate with: openssl rand -hex 32
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=10080
ALGORITHM=HS256

# === API Key Auth ===
API_KEY=change-me-in-production
API_KEY_HEADER=X-API-Key

# === Redis ===
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=
REDIS_DB=0

# === Celery ===
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0


# === AI Agent (pydantic_ai, anthropic) ===
ANTHROPIC_API_KEY=

# === OpenAI (optional — not required) ===
OPENAI_API_KEY=
AI_MODEL=claude-sonnet-4-6
AI_TEMPERATURE=0.7

# === Hybrid Router (Claude CLI + Local AI) ===
CLAUDE_CLI_PATH=claude
# Routing mode controls which backend handles chat sessions:
#   auto         — Claude for write tasks when online; Ollama for read/Q&A (default)
#   prefer_local — Ollama when available, Claude as fallback
#   prefer_cloud — Claude when available, Ollama as fallback
#   force_local  — Always Ollama (offline mode, zero cost)
#   force_cloud  — Always Claude CLI (ignore local model)
ROUTING_MODE=auto

# === OMNI UI/UX Skill Server ===
# Run: cd OMNI-UI-UX/omni-mcp && uvicorn adapter:app --port 8090
# Leave empty to disable OMNI injection in Engineer agent
OMNI_URL=http://localhost:8090

# === Argomemory (Memory Brain Tier 2) ===
# REST server URL — argomemory must be running locally
ARGOMEMORY_URL=http://localhost:3111
ARGOMEMORY_SECRET=
# Absolute path to standalone.mjs — enables argomemory MCP in every Claude session
# Leave empty to disable MCP injection (REST recall still works)
ARGOMEMORY_MCP_PATH=/path/to/argomemory/dist/standalone.mjs
ARGOMEMORY_ENABLED=true

# === MinIO (object storage for Chiron source files) ===
# Leave MINIO_ACCESS_KEY empty to fall back to local filesystem storage
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET_CHIRON=chiron-sources
MINIO_SECURE=false

# === Local AI Agent (Ollama) ===
# Install Ollama: https://ollama.ai
# Pull models before use:
#   ollama pull qwen2.5-coder:3b      # fast, 2GB  — good for simple tasks
#   ollama pull qwen2.5-coder:7b      # balanced, 5GB — recommended
#   ollama pull qwen2.5-coder:32b     # best quality, 19GB — needs 24GB RAM
#   ollama pull deepseek-coder:6.7b   # alternative coder model
# Point OLLAMA_HOST to Argorouter for access to 40+ providers via the same API.
OLLAMA_HOST=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen2.5-coder:3b      # main coding model (override for larger model)
OLLAMA_PLAN_MODEL=qwen2.5-coder:3b      # task planner model (can be same or smaller)
LOCAL_CONTEXT_TOKENS=6000               # RAG + memory budget per session (tokens)
LOCAL_MAX_TOOL_ITERATIONS=20            # max tool calls per session (loop guard)

# === Chiron Embeddings (Ollama — local, free) ===
# Pull model first: ollama pull nomic-embed-text
# Leave OLLAMA_HOST empty to disable vector search (TF-IDF fallback stays active)
CHIRON_EMBEDDING_MODEL=nomic-embed-text

# === Chiron MCP (Knowledge Brain Tier 3) ===
# Base URL of this FastAPI server — used to construct the Chiron MCP URL for Claude CLI
CHIRON_MCP_BASE_URL=http://localhost:8000

# === CORS ===
# JSON list of allowed origins (default: localhost:3000, localhost:8080)
# Note: "*" is blocked in production - specify explicit origins
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]

# === Docker Production (Traefik) ===
# Domain for production deployment
DOMAIN=example.com

# Let's Encrypt email for SSL certificates
ACME_EMAIL=admin@example.com

# Traefik dashboard auth (generate with: htpasswd -nb admin password)
# TRAEFIK_DASHBOARD_AUTH=admin:$$apr1$$...
# Redis password for production
REDIS_PASSWORD=change-me-in-production
# Flower monitoring credentials
FLOWER_USER=admin
FLOWER_PASSWORD=change-me-in-production

# === ArgoHarness ===
# Auto-resolved to .claude/skills/argoharness/ — only set if using a custom path
# ARGOHARNESS_SKILLS_DIR=

# Model tiers — adjust for your hardware
OLLAMA_TIER0_MODEL=qwen2.5:0.5b
OLLAMA_TIER1_MODEL=qwen2.5-coder:3b
OLLAMA_TIER2_MODEL=gemma4:31b-cloud

# Verification gate
HARNESS_JUDGE_MODEL=qwen2.5:0.5b
HARNESS_VERIFICATION_THRESHOLD=7
HARNESS_MAX_RETRIES=2

# Feature toggles (set to false to disable)
HARNESS_SKILL_INJECTION_ENABLED=true
HARNESS_VERIFICATION_ENABLED=true
HARNESS_GEMMA4_THINKING_ENABLED=true

# Web search
WEB_SEARCH_PROVIDER=duckduckgo
WEB_SEARCH_BRAVE_API_KEY=
WEB_SEARCH_SEARXNG_URL=http://localhost:8080

# Chiron intelligence
CHIRON_RERANK=false

# === Audio STT ===
STT_PROVIDER=whisper  # whisper (local) or openai
# OPENAI_API_KEY=sk-...  # Required if STT_PROVIDER=openai
